{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrandX",
  "version": "0.1.0",
  "identifier": "com.brandx.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BrandX",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
